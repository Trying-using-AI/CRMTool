{
  "name": "crmtool",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "crmtool",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*",
        "services/*"
      ]
    },
    "apps/api": {
      "name": "@crmtool/api",
      "version": "0.1.0",
      "dependencies": {
        "@crmtool/analytics": "0.1.0",
        "@crmtool/types": "0.1.0",
        "@crmtool/vendor-core": "0.1.0"
      }
    },
    "apps/web": {
      "name": "@crmtool/web",
      "version": "0.1.0",
      "dependencies": {
        "@crmtool/types": "0.1.0"
      }
    },
    "node_modules/@crmtool/analytics": {
      "resolved": "packages/analytics",
      "link": true
    },
    "node_modules/@crmtool/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@crmtool/scheduler": {
      "resolved": "services/scheduler",
      "link": true
    },
    "node_modules/@crmtool/types": {
      "resolved": "packages/types",
      "link": true
    },
    "node_modules/@crmtool/vendor-core": {
      "resolved": "packages/vendor-core",
      "link": true
    },
    "node_modules/@crmtool/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@crmtool/webhook-consumer": {
      "resolved": "services/webhook-consumer",
      "link": true
    },
    "node_modules/@crmtool/worker": {
      "resolved": "services/worker",
      "link": true
    },
    "packages/analytics": {
      "name": "@crmtool/analytics",
      "version": "0.1.0",
      "dependencies": {
        "@crmtool/types": "0.1.0"
      }
    },
    "packages/types": {
      "name": "@crmtool/types",
      "version": "0.1.0"
    },
    "packages/vendor-core": {
      "name": "@crmtool/vendor-core",
      "version": "0.1.0",
      "dependencies": {
        "@crmtool/types": "0.1.0"
      }
    },
    "services/scheduler": {
      "name": "@crmtool/scheduler",
      "version": "0.1.0"
    },
    "services/webhook-consumer": {
      "name": "@crmtool/webhook-consumer",
      "version": "0.1.0"
    },
    "services/worker": {
      "name": "@crmtool/worker",
      "version": "0.1.0"
    }
  }
}
